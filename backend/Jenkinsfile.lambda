pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    AWS_REGION    = 'ap-southeast-2'
    FUNCTION_NAME = 'skribl-backend'
    JAR_NAME      = 'skribl-backend-0.0.1-SNAPSHOT.jar'
    ZIP_NAME      = 'skribl-backend-lambda.zip'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Test') {
      steps {
        dir('backend') {
          sh 'mvn -B test'
        }
      }
    }

    stage('Build JAR') {
      steps {
        dir('backend') {
          sh 'mvn -B clean package -DskipTests'
        }
      }
    }

    stage('Package Lambda Zip') {
      steps {
        dir('backend/target') {
          // Lambda zip packages need the jar at the root of the archive
          sh 'rm -f $ZIP_NAME && cp $JAR_NAME app.jar && zip -q $ZIP_NAME app.jar && rm app.jar'
        }
      }
    }

    stage('Upload to S3') {
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-jenkins-creds']]) {
          sh '''
            ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
            BUCKET=skribl-artifacts-$ACCOUNT_ID-$AWS_REGION
            KEY=backend/$BUILD_NUMBER/$ZIP_NAME

            if ! aws s3api head-bucket --bucket $BUCKET >/dev/null 2>&1; then
              aws s3api create-bucket --bucket $BUCKET --region $AWS_REGION \
                --create-bucket-configuration LocationConstraint=$AWS_REGION
              aws s3api put-public-access-block --bucket $BUCKET \
                --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
            fi

            aws s3 cp backend/target/$ZIP_NAME s3://$BUCKET/$KEY --region $AWS_REGION
            echo $BUCKET > s3-bucket.txt
            echo $KEY > s3-key.txt
          '''
        }
      }
    }

    stage('Deploy to Lambda') {
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-jenkins-creds']]) {
          sh '''
            aws lambda update-function-code \
              --function-name $FUNCTION_NAME \
              --s3-bucket $(cat s3-bucket.txt) \
              --s3-key $(cat s3-key.txt) \
              --region $AWS_REGION \
              --no-cli-pager

            aws lambda wait function-updated-v2 \
              --function-name $FUNCTION_NAME \
              --region $AWS_REGION
          '''
        }
      }
    }
  }

  post {
    success {
      archiveArtifacts artifacts: 'backend/target/*.jar, backend/target/*.zip', fingerprint: true
      echo "Deployed build $BUILD_NUMBER to Lambda $FUNCTION_NAME"
    }
    failure {
      echo 'Deployment failed. Check the stage logs above.'
    }
  }
}
